{
  "display_information": {
    "name": "Atlas - Manager",
    "background_color": "#172235",
    "description": "Manager — plans work, coordinates engineers, validates changes and prepares your Merge handoff."
  },
  "features": {
    "bot_user": {
      "display_name": "Atlas - Manager",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write"
      ]
    }
  },
  "settings": {
    "token_rotation_enabled": false,
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true
  }
}
